# ─────────────────────────────────────────────────────────────
#  Oynur Bouw website — environment settings
#  Copy this file to ".env.local" and fill in the values.
# ─────────────────────────────────────────────────────────────

# Public address of the website (no trailing slash). Used for SEO:
# canonical links, sitemap, Open Graph images, structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel login (/admin)
ADMIN_EMAIL=info@oynurbouw.nl
ADMIN_PASSWORD=qDKSpNc7csbp

# Secret used to sign the admin session cookie. Any long random string (32+ chars).
AUTH_SECRET=7f238e66f66faac9d52ca3abb8047f68d0f3e1d9d0f78af7ba24ddd6e7ab7cc0

# Optional: Google Search Console verification code (content of the meta tag)
GOOGLE_SITE_VERIFICATION=

# Optional: e-mail notification when someone submits the contact form.
# Leave empty to only store requests in the admin panel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# Optional: where content is stored (database + uploaded photos). Default: ./storage
# STORAGE_DIR=./storage
